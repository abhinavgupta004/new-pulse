# Server
PORT=4000
# CORS: the deployed frontend origin (comma-separate multiple if needed)
CORS_ORIGIN=http://localhost:3000

# Must point at the same SQLite file the Python scraper writes to.
SQLITE_PATH=../scraper/news_pulse.db

# How the API invokes the scraper for POST /ingest/trigger
PYTHON_BIN=python3
SCRAPER_ENTRYPOINT=../scraper/main.py
SCRAPER_CWD=../scraper
